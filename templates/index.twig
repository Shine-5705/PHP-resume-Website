<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ seo.title }}</title>

    <meta name="description" content="{{ seo.description }}">
    <meta name="keywords" content="{{ seo.keywords }}">
    <meta name="author" content="{{ seo.author }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ seo.url }}">

    <meta property="og:title" content="{{ seo.title }}">
    <meta property="og:description" content="{{ seo.description }}">
    <meta property="og:image" content="{{ seo.image }}">
    <meta property="og:url" content="{{ seo.url }}">
    <meta property="og:type" content="{{ seo.type }}">
    <meta property="og:locale" content="{{ seo.locale }}">
    <meta property="og:site_name" content="{{ seo.site_name }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seo.title }}">
    <meta name="twitter:description" content="{{ seo.description }}">
    <meta name="twitter:image" content="{{ seo.image }}">
    <meta name="twitter:creator" content="@shine_gupta17">
    <meta name="twitter:site" content="@shine_gupta17">

    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Shine Gupta - AI Engineer & Full-Stack Developer">

    <meta name="theme-color" content="#ededed">
    <meta name="application-name" content="{{ seo.site_name }}">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <link rel="preload" href="/css/theme.css" as="style">
    <link rel="stylesheet" href="/css/theme.css">

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Shine Gupta",
        "jobTitle": "AI Engineer & Full-Stack Developer",
        "description": "{{ seo.description }}",
        "url": "{{ seo.url }}",
        "image": "{{ seo.image }}",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bengaluru",
            "addressCountry": "India"
        },
        "sameAs": [
            "https://github.com/Shine-5705",
            "https://www.linkedin.com/in/shine-gupta-62b22b264",
            "https://scholar.google.com/citations?user=kx3_tLYAAAAJ&hl=en",
            "https://openreview.net/profile?id=~Shine_Gupta2",
            "https://x.com/shine_gupta17"
        ]
    }
    </script>
</head>
<body>
    <div class="background-shapes" aria-hidden="true">
        <div class="blur-orb"></div>
        <div class="blur-orb"></div>
        <div class="blur-orb"></div>
    </div>

    <nav class="floating-nav" aria-label="Primary">
        <div class="floating-nav__container">
            <a href="/" class="floating-nav__link floating-nav__link--active" aria-current="page">Home</a>
            <a href="/projects" class="floating-nav__link">Projects</a>
            <a href="/publications" class="floating-nav__link">Publications</a>
            <a href="/blog/" class="floating-nav__link">Blog</a>
            <a href="/hackathons" class="floating-nav__link">Hackathons</a>
        </div>
    </nav>

    <main class="page-container">

        <div class="hero-card">
            <div class="hero-photo">
                <img src="assets/images/profile.webp" alt="Photo of {{ profile.name }}">
            </div>
            <div class="hero-info">
                <h1>{{ profile.name }}</h1>
                <p class="hero-role">{{ profile.description }}</p>
                <a class="hero-location" href="https://www.google.com/maps/place/Bengaluru" target="_blank" rel="noopener noreferrer">📍 {{ profile.location }}</a>

                <div id="social">
                    <a href="mailto:guptashine5002@gmail.com" title="Email"><img src="assets/icons/mail.png" alt="Email"></a>
                    <a href="https://github.com/Shine-5705" target="_blank" rel="noopener noreferrer" title="GitHub"><img src="assets/icons/github.png" alt="GitHub"></a>
                    <a href="https://scholar.google.com/citations?user=kx3_tLYAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" title="Google Scholar"><img src="assets/icons/scholar.svg" alt="Google Scholar"></a>
                    <a href="https://www.linkedin.com/in/shine-gupta-62b22b26" target="_blank" rel="noopener noreferrer" title="LinkedIn"><img src="assets/icons/linkedin.png" alt="LinkedIn"></a>
                    <a href="https://x.com/shine_gupta17" target="_blank" rel="noopener noreferrer" title="X / Twitter"><img src="assets/icons/x.svg" alt="X"></a>
                </div>

                <div id="cta">
                    <a href="/blog/">Visit Blog</a>
                    <a href="https://openreview.net/profile?id=~Shine_Gupta2" target="_blank" rel="noopener noreferrer">OpenReview Profile</a>
                </div>
            </div>
        </div>

        <div class="statement">{{ profile.about }}</div>

        <section class="section-block">
            <h2 id="work-experience">Work Experience</h2>
            {% for job in workExperience %}
            <article class="card">
                <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                    <h3><a href="{{ job.url }}" target="_blank" rel="noopener noreferrer">{{ job.company }}</a></h3>
                    <div class="card-meta">{{ job.period }}</div>
                </div>
                <div class="card-role">{{ job.position }}{% if job.location %} · {{ job.location }}{% endif %}</div>
                <p>{{ job.description }}</p>
                {% if job.details %}
                <ul class="details">
                    {% for detail in job.details %}
                    <li>{{ detail }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
                <ul class="tag-list">
                    {% for tag in job.tags %}
                    <li><span class="tag-pill">{{ tag }}</span></li>
                    {% endfor %}
                </ul>
            </article>
            {% endfor %}
        </section>

        <section class="section-block">
            <h2 id="education-section">Education</h2>
            {% for edu in education %}
            <article class="card">
                <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                    <h3>{{ edu.institution }}</h3>
                    <div class="card-meta">{{ edu.period }}</div>
                </div>
                <p>{{ edu.degree }}</p>
            </article>
            {% endfor %}
        </section>

        <section class="section-block">
            <h2 id="skills-section">Skills</h2>
            <div class="skills-categories">
                {% for category, skills in skillCategories %}
                <div class="card">
                    <h3 style="font-size:1rem;">{{ category }}</h3>
                    <ul class="tag-list">
                        {% for skill in skills %}
                        <li><span class="tag-pill">{{ skill }}</span></li>
                        {% endfor %}
                    </ul>
                </div>
                {% endfor %}
            </div>
        </section>

        <section class="news-section" aria-labelledby="news-heading">
            <div class="news-section__header">
                <h2 id="news-heading">News</h2>
                <span class="news-section__subhead">Recent highlights</span>
            </div>
            <ul class="news-list">
                {% for item in news %}
                <li class="news-item">
                    <span class="news-item__date">{{ item.date }}</span>
                    <span class="news-item__text">{{ item.text|raw }}</span>
                </li>
                {% endfor %}
            </ul>
        </section>

    </main>

    <div class="site-footer">Last updated on {{ "now"|date("d F Y") }}.</div>
</body>
</html>
